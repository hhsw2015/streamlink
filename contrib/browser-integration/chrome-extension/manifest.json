{
  "manifest_version": 3,
  "name": "Streamlink Redirect",
  "version": "0.2.0",
  "description": "Right-click a video page or link to play it via streamlink-ytplay / streamlink-redirect.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {},
  "key": ""
}
